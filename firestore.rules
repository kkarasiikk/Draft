rules_version = '2';

// Модель даних (за app.js):
//   users/{uid}                       -- профіль: lang, currency, theme,
//                                         categoriesIncome, categoriesExpense, ...
//   users/{uid}/transactions/{id}     -- {type, amount, category, note, date}
//   users/{uid}/savings/{id}          -- {type, amount, currency, note, date, goalId}
//   users/{uid}/savingsGoals/{id}     -- {name, createdAt}
//   users/{uid}/pages/{id}            -- {title, content, createdAt, updatedAt}
//   users/{uid}/tasks/{id}            -- {title, notes, done, priority, tags,
//                                         dueDate, dueTime, reminderMinutesBefore,
//                                         reminderAt, notifiedAt, subtasks,
//                                         createdAt, updatedAt}
//   users/{uid}/fcmTokens/{token}     -- {createdAt, userAgent} (для push-нагадувань)
//
// Правило: кожен користувач може читати й писати ЛИШЕ власні документи,
// і лише якщо форма даних відповідає тому, що реально пише застосунок —
// це другий рівень захисту (перший — App Check) на випадок зіпсованого/
// зловмисного запиту напряму через Firestore SDK (в обхід UI застосунку).

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    match /users/{uid} {
      // Профіль має гнучку, таку що еволюціонує, схему (нові налаштування
      // додаються з часом) — перевіряємо типи тільки для полів, які реально
      // присутні в записі, а не жорстко фіксуємо повний список ключів.
      function isValidProfile(d) {
        return (!('lang' in d) || d.lang is string) &&
               (!('currency' in d) || d.currency is string) &&
               (!('theme' in d) || d.theme is string) &&
               (!('categoriesIncome' in d) || d.categoriesIncome is list) &&
               (!('categoriesExpense' in d) || d.categoriesExpense is list);
      }
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidProfile(request.resource.data);

      match /transactions/{txId} {
        function isValidTx(d) {
          return d.type in ['income', 'expense'] &&
                 d.amount is number && d.amount > 0 && d.amount < 1000000000 &&
                 isNonEmptyString(d.category, 100) &&
                 d.date is string && d.date.size() == 10 &&
                 d.note is string && d.note.size() <= 2000 &&
                 (!('source' in d) || d.source is string) &&
                 (!('createdAt' in d) || d.createdAt is timestamp) &&
                 d.keys().hasOnly(['type', 'amount', 'category', 'note', 'date', 'source', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTx(request.resource.data);
      }

      match /savings/{savingId} {
        function isValidSaving(d) {
          return d.type in ['deposit', 'withdraw'] &&
                 d.amount is number && d.amount > 0 && d.amount < 1000000000 &&
                 isNonEmptyString(d.currency, 10) &&
                 d.date is string && d.date.size() == 10 &&
                 d.note is string && d.note.size() <= 2000 &&
                 isNonEmptyString(d.goalId, 200) &&
                 d.keys().hasOnly(['type', 'amount', 'currency', 'note', 'date', 'goalId']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSaving(request.resource.data);
      }

      match /savingsGoals/{goalId} {
        function isValidGoal(d) {
          return isNonEmptyString(d.name, 200) &&
                 d.createdAt is timestamp &&
                 d.keys().hasOnly(['name', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidGoal(request.resource.data);
      }

      match /pages/{pageId} {
        function isValidPage(d) {
          return d.title is string && d.title.size() <= 300 &&
                 d.content is string && d.content.size() <= 500000 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidPage(request.resource.data);
      }

      match /tasks/{taskId} {
        // reminderAt/notifiedAt — обчислені клієнтом Timestamp-поля, за якими
        // планова Cloud Function (tasks.js -> taskReminders) вибирає, кому й
        // коли надіслати push. notifiedAt виставляє САМЕ Cloud Function
        // (Admin SDK, обходить ці правила) після відправки — з боку клієнта
        // дозволяємо лише скидати його в null (коли час/нагадування міняють).
        // Примітка: правила тут не перевіряють форму КОЖНОГО елемента
        // subtasks (мова правил Firestore не має зручного способу пройтись
        // по списку довільної довжини) — лише що це список і не задовгий.
        // Форму окремих підзадач ({id, title, done}) гарантує клієнтський
        // код (renderSubtasksEditor у tasks/app.js), а не правила.
        function isValidTask(d) {
          return isNonEmptyString(d.title, 200) &&
                 d.notes is string && d.notes.size() <= 5000 &&
                 d.done is bool &&
                 (d.priority == null || d.priority in ['low', 'medium', 'high']) &&
                 d.tags is list && d.tags.size() <= 20 &&
                 (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10)) &&
                 (d.dueTime == null || (d.dueTime is string && d.dueTime.size() == 5)) &&
                 (d.reminderMinutesBefore == null || d.reminderMinutesBefore is number) &&
                 (d.reminderAt == null || d.reminderAt is timestamp) &&
                 d.notifiedAt == null &&
                 d.subtasks is list && d.subtasks.size() <= 50 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'notes', 'done', 'priority', 'tags', 'dueDate',
                   'dueTime', 'reminderMinutesBefore', 'reminderAt', 'notifiedAt', 'subtasks',
                   'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTask(request.resource.data);
      }

      match /fcmTokens/{token} {
        // Документи для push-нагадувань (tasks.js). id документа = сам FCM-токен.
        function isValidFcmToken(d) {
          return d.createdAt is timestamp &&
                 d.userAgent is string && d.userAgent.size() <= 300 &&
                 d.keys().hasOnly(['createdAt', 'userAgent']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidFcmToken(request.resource.data);
      }
    }

    // Все інше — заборонено за замовчуванням.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
