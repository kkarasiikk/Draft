rules_version = '2';

// Модель даних (за app.js):
//   users/{uid}                       -- профіль: lang, currency, theme,
//                                         categoriesIncome, categoriesExpense, ...
//   users/{uid}/transactions/{id}     -- {type, amount, category, note, date}
//   users/{uid}/savings/{id}          -- {type, amount, currency, note, date, goalId}
//   users/{uid}/savingsGoals/{id}     -- {name, createdAt}
//   users/{uid}/recurringTx/{id}      -- {type, amount, category, note,
//                                         recurrence, nextDate, active,
//                                         createdAt, updatedAt}
//   users/{uid}/pages/{id}            -- {title, content, createdAt, updatedAt}
//   users/{uid}/tasks/{id}            -- {title, notes, done, completedAt,
//                                         priority, tags, dueDate, dueTime,
//                                         estimateMin, recurrence, subtasks,
//                                         reminderAt, notifiedAt, goalId,
//                                         createdAt, updatedAt}
//   users/{uid}/taskTemplates/{id}    -- {title, notes, priority, tags,
//                                         estimateMin, subtasks,
//                                         createdAt, updatedAt}
//   users/{uid}/fcmTokens/{token}     -- {createdAt, ua, tz}
//   users/{uid}/aiMessages/{id}       -- {role, text, at}
//   users/{uid}/workouts/{id}         -- {date, name, notes, exercises: [
//                                         {id, libId, customId, muscle, name, sets: [
//                                         {weight, reps}]}], createdAt, updatedAt}
//   users/{uid}/workoutTemplates/{id} -- {name, exercises: [{id, libId, muscle,
//                                         name, sets: [{weight, reps}]}],
//                                         createdAt, updatedAt}
//   users/{uid}/customExercises/{id}  -- {name, muscle, createdAt}
//   users/{uid}/readiness/{YYYY-MM-DD}  -- {level: ready|ok|low, date, createdAt}
//   users/{uid}/goals/{id}            -- {title, category, why, targetDate,
//                                         targetValue, currentValue, unit,
//                                         status, milestones: [{id, title, done}],
//                                         checkins: [YYYY-MM-DD], journal: [
//                                         {id, text, createdAt}], rescues: [YYYY-MM-DD],
//                                         blockers: [{date, reason}], createdAt, updatedAt}
//
// Правило: кожен користувач може читати й писати ЛИШЕ власні документи,
// і лише якщо форма даних відповідає тому, що реально пише застосунок —
// це другий рівень захисту (перший — App Check) на випадок зіпсованого/
// зловмисного запиту напряму через Firestore SDK (в обхід UI застосунку).

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    match /users/{uid} {
      // Профіль має гнучку, таку що еволюціонує, схему (нові налаштування
      // додаються з часом) — перевіряємо типи тільки для полів, які реально
      // присутні в записі, а не жорстко фіксуємо повний список ключів.
      function isValidProfile(d) {
        return (!('lang' in d) || d.lang is string) &&
               (!('currency' in d) || d.currency is string) &&
               (!('theme' in d) || d.theme is string) &&
               (!('categoriesIncome' in d) || d.categoriesIncome is list) &&
               (!('categoriesExpense' in d) || d.categoriesExpense is list) &&
               // Яку модель питати в AI-помічнику: haiku | sonnet | opus.
               (!('aiModel' in d) || d.aiModel is string) &&
               // План витрат на місяць: число або null (плану немає). Від нього
               // залежить кільце «витрачено з плану» на головній.
               (!('monthlyBudget' in d) || d.monthlyBudget == null ||
                 (d.monthlyBudget is number && d.monthlyBudget > 0)) &&
               // Налаштування нагадувань: { enabled, morningHour, eveningHour,
               // tz, lastMorning, lastEvening }. Дві останні дати пише Cloud
               // Function (адмінський SDK правила обходить), решту — клієнт.
               (!('taskReminders' in d) || d.taskReminders is map);
      }
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidProfile(request.resource.data);

      match /transactions/{txId} {
        function isValidTx(d) {
          return d.type in ['income', 'expense'] &&
                 d.amount is number && d.amount > 0 && d.amount < 1000000000 &&
                 isNonEmptyString(d.category, 100) &&
                 d.date is string && d.date.size() == 10 &&
                 d.note is string && d.note.size() <= 2000 &&
                 (!('source' in d) || d.source is string) &&
                 (!('createdAt' in d) || d.createdAt is timestamp) &&
                 d.keys().hasOnly(['type', 'amount', 'category', 'note', 'date', 'source', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTx(request.resource.data);
      }

      match /savings/{savingId} {
        function isValidSaving(d) {
          return d.type in ['deposit', 'withdraw'] &&
                 d.amount is number && d.amount > 0 && d.amount < 1000000000 &&
                 isNonEmptyString(d.currency, 10) &&
                 d.date is string && d.date.size() == 10 &&
                 d.note is string && d.note.size() <= 2000 &&
                 isNonEmptyString(d.goalId, 200) &&
                 d.keys().hasOnly(['type', 'amount', 'currency', 'note', 'date', 'goalId']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSaving(request.resource.data);
      }

      match /savingsGoals/{goalId} {
        function isValidGoal(d) {
          return isNonEmptyString(d.name, 200) &&
                 d.createdAt is timestamp &&
                 d.keys().hasOnly(['name', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidGoal(request.resource.data);
      }

      // Регулярні операції (оренда, підписки, зарплата) — це ПРАВИЛО, а не
      // транзакція: сама транзакція створюється лише тоді, коли людина
      // підтвердила, що операція справді відбулась. Тому тут немає date —
      // натомість nextDate каже, коли настане наступна.
      match /recurringTx/{ruleId} {
        function isValidRecurringTx(d) {
          return d.type in ['income', 'expense'] &&
                 d.amount is number && d.amount > 0 && d.amount < 1000000000 &&
                 isNonEmptyString(d.category, 100) &&
                 d.note is string && d.note.size() <= 2000 &&
                 d.nextDate is string && d.nextDate.size() == 10 &&
                 d.recurrence is map &&
                 d.active is bool &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['type', 'amount', 'category', 'note', 'recurrence',
                                   'nextDate', 'active', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidRecurringTx(request.resource.data);
      }

      match /pages/{pageId} {
        function isValidPage(d) {
          return d.title is string && d.title.size() <= 300 &&
                 d.content is string && d.content.size() <= 500000 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidPage(request.resource.data);
      }

      match /tasks/{taskId} {
        // Примітка: правила тут не перевіряють форму КОЖНОГО елемента
        // subtasks (мова правил Firestore не має зручного способу пройтись
        // по списку довільної довжини) — лише що це список і не задовгий.
        // Форму окремих підзадач ({id, title, done}) гарантує клієнтський
        // код (renderSubtasksEditor у tasks/app.js), а не правила.
        function isValidTask(d) {
          return isNonEmptyString(d.title, 200) &&
                 d.notes is string && d.notes.size() <= 5000 &&
                 d.done is bool &&
                 // Момент виконання: null, поки завдання не зроблене. Саме з
                 // цього поля рахується історія й статистика, тож без нього
                 // «виконано» лишалось би фактом без часу.
                 (!('completedAt' in d) || d.completedAt == null || d.completedAt is timestamp) &&
                 (d.priority == null || d.priority in ['low', 'medium', 'high']) &&
                 d.tags is list && d.tags.size() <= 20 &&
                 (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10)) &&
                 (d.dueTime == null || (d.dueTime is string && d.dueTime.size() == 5)) &&
                 // Оцінка тривалості у хвилинах — від 1 хвилини до доби.
                 (!('estimateMin' in d) || d.estimateMin == null ||
                   (d.estimateMin is number && d.estimateMin > 0 && d.estimateMin <= 1440)) &&
                 // Форму правила повторення ({type, interval, weekdays, day,
                 // anchor}) гарантує клієнтський код і tasks/recurrence.js —
                 // як і з subtasks, тут перевіряємо лише тип поля.
                 (!('recurrence' in d) || d.recurrence == null || d.recurrence is map) &&
                 // Нагадування: момент, коли слати push, і момент, коли його
                 // вже надіслали. Друге поле пише Cloud Function, тому воно
                 // теж має бути дозволене.
                 (!('reminderAt' in d) || d.reminderAt == null || d.reminderAt is timestamp) &&
                 (!('notifiedAt' in d) || d.notifiedAt == null || d.notifiedAt is timestamp) &&
                 // Завдання може бути щоденною дією з довгострокової цілі:
                 // тоді тут лежить id цілі, і виконання відмічає її день.
                 (!('goalId' in d) || d.goalId == null || (d.goalId is string && d.goalId.size() <= 64)) &&
                 d.subtasks is list && d.subtasks.size() <= 50 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'notes', 'done', 'completedAt', 'priority', 'tags',
                   'dueDate', 'dueTime', 'estimateMin', 'recurrence', 'subtasks',
                   'reminderAt', 'notifiedAt', 'goalId', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTask(request.resource.data);
      }

      // Шаблони завдань: готовий набір кроків, з якого одним тапом
      // народжується звичайне завдання. Дати тут немає свідомо — шаблон не
      // живе в календарі, дату він отримує в момент застосування.
      match /taskTemplates/{templateId} {
        function isValidTemplate(d) {
          return isNonEmptyString(d.title, 200) &&
                 d.notes is string && d.notes.size() <= 5000 &&
                 (d.priority == null || d.priority in ['low', 'medium', 'high']) &&
                 d.tags is list && d.tags.size() <= 20 &&
                 (!('estimateMin' in d) || d.estimateMin == null ||
                   (d.estimateMin is number && d.estimateMin > 0 && d.estimateMin <= 1440)) &&
                 d.subtasks is list && d.subtasks.size() <= 50 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'notes', 'priority', 'tags', 'estimateMin',
                   'subtasks', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTemplate(request.resource.data);
      }

      // Історія чату з AI-помічником. Лежить у Firestore, а не в
      // localStorage, щоб розмова не зникала після перезавантаження і була
      // та сама на телефоні й на комп'ютері. Порядок задає `at` (мілісекунди
      // клієнта): serverTimestamp дав би однаковий час кільком реплікам,
      // записаним однією відповіддю, і вони переставлялися б місцями.
      match /aiMessages/{messageId} {
        function isValidAiMessage(d) {
          return d.role in ['user', 'assistant', 'action'] &&
                 isNonEmptyString(d.text, 8000) &&
                 d.at is number &&
                 d.keys().hasOnly(['role', 'text', 'at']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidAiMessage(request.resource.data);
      }

      // Токени пристроїв для push-нагадувань. Ідентифікатор документа — сам
      // токен від FCM, тож повторна реєстрація того самого пристрою просто
      // перезаписує запис, а не плодить дублікати.
      match /fcmTokens/{token} {
        function isValidToken(d) {
          return d.createdAt is timestamp &&
                 (!('ua' in d) || (d.ua is string && d.ua.size() <= 500)) &&
                 (!('tz' in d) || (d.tz is string && d.tz.size() <= 60)) &&
                 d.keys().hasOnly(['createdAt', 'ua', 'tz']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidToken(request.resource.data);
      }

      match /workouts/{workoutId} {
        // Як і з tasks/subtasks, форму КОЖНОГО елемента exercises/sets тут не
        // перевіряємо (мова правил не дає зручно пройтись по вкладеному
        // списку довільної довжини) — лише що це список і не задовгий.
        // Форму окремих вправ/підходів ({id, libId, muscle, name, sets:[{weight,reps}]})
        // гарантує клієнтський код (sessionForm submit-handler у workout/app.js).
        function isValidWorkout(d) {
          return d.date is string && d.date.size() == 10 &&
                 d.name is string && d.name.size() <= 120 &&
                 d.notes is string && d.notes.size() <= 3000 &&
                 d.exercises is list && d.exercises.size() >= 1 && d.exercises.size() <= 30 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['date', 'name', 'notes', 'exercises', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWorkout(request.resource.data);
      }

      // Готовий каркас тренування: ті самі вправи й підходи, з яких щоразу
      // починається однакова сесія. На відміну від workouts тут немає дати
      // й нотатки — шаблон описує, ЩО робити, а не коли й як пройшло.
      match /workoutTemplates/{templateId} {
        // Форму кожного елемента exercises/sets, як і в workouts, гарантує
        // клієнтський код (saveSessionAsTemplate у workout/app.js).
        function isValidWorkoutTemplate(d) {
          return isNonEmptyString(d.name, 120) &&
                 d.exercises is list && d.exercises.size() >= 1 && d.exercises.size() <= 30 &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['name', 'exercises', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWorkoutTemplate(request.resource.data);
      }

      // Самопочуття перед тренуванням. Сну й пульсу застосунок не знає —
      // це веб-сторінка без доступу до годинника, — тож єдине чесне
      // джерело це сама людина. Id документа — день, тож на добу один запис.
      match /readiness/{dayId} {
        function isValidReadiness(d) {
          return d.level in ['ready', 'ok', 'low'] &&
                 d.date is string && d.date.size() == 10 &&
                 d.createdAt is timestamp &&
                 d.keys().hasOnly(['level', 'date', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidReadiness(request.resource.data);
      }

      // Власні вправи, яких немає в бібліотеці: людина додає одну з
      // групою мʼязів, і далі вона просто обирається зі списку в пікері,
      // а не набирається наново щоразу.
      match /customExercises/{exerciseId} {
        function isValidCustomExercise(d) {
          return isNonEmptyString(d.name, 120) &&
                 d.muscle in ['chest', 'back', 'legs', 'shoulders', 'arms', 'core'] &&
                 d.createdAt is timestamp &&
                 d.keys().hasOnly(['name', 'muscle', 'createdAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidCustomExercise(request.resource.data);
      }

      match /goals/{goalId} {
        // Як і з tasks/subtasks та workouts/exercises: форму КОЖНОГО елемента
        // milestones/checkins/journal тут не перевіряємо — лише що це список
        // і не задовгий. Форму окремих елементів гарантує клієнтський код
        // (goals/app.js: submit-handler форми, toggleMilestone, toggleTodayCheckin,
        // addJournalEntry).
        function isValidLifeGoal(d) {
          return isNonEmptyString(d.title, 200) &&
                 d.category in ['health', 'finance', 'learning', 'career',
                   'relationships', 'travel', 'creativity', 'other'] &&
                 d.why is string && d.why.size() <= 1000 &&
                 (d.targetDate == null || (d.targetDate is string && d.targetDate.size() == 10)) &&
                 // Числова мета: «10» + «км». Її може не бути — тоді прогрес
                 // рахується за віхами, як і раніше.
                 (!('targetValue' in d) || d.targetValue == null ||
                   (d.targetValue is number && d.targetValue > 0 && d.targetValue < 1000000000)) &&
                 (!('currentValue' in d) || d.currentValue is number) &&
                 (!('unit' in d) || (d.unit is string && d.unit.size() <= 20)) &&
                 // 'paused' — ціль жива, але про неї свідомо не питають:
                 // відпустка, зміна обставин. Без неї лишався вибір між
                 // «щовечора нагадувати» і «поховати в архів».
                 d.status in ['active', 'done', 'archived', 'paused'] &&
                 d.milestones is list && d.milestones.size() <= 50 &&
                 d.checkins is list && d.checkins.size() <= 400 &&
                 d.journal is list && d.journal.size() <= 200 &&
                 // Врятовані дні й причини пропусків. Обидва списки старі
                 // документи не мають — тому лише перевіряємо форму тих, що є.
                 (!('rescues' in d) || (d.rescues is list && d.rescues.size() <= 50)) &&
                 (!('blockers' in d) || (d.blockers is list && d.blockers.size() <= 200)) &&
                 // Журнал прогресу: [{date, delta}]. currentValue лишається
                 // сумою — його показує смужка, — але саме по собі одне число
                 // не памʼятає, КОЛИ прогрес був, а без цього не порахувати
                 // ні темп, ні рух за тиждень. Форму елементів, як і всюди
                 // поруч, гарантує клієнт (addGoalProgress у goals/app.js).
                 (!('progressLog' in d) || (d.progressLog is list && d.progressLog.size() <= 400)) &&
                 // Коли ціль звʼязана зі скарбничкою бюджету, число береться
                 // з реальних операцій, а не вбивається руками.
                 (!('savingsGoalId' in d) || d.savingsGoalId == null ||
                   (d.savingsGoalId is string && d.savingsGoalId.size() <= 64)) &&
                 // Дата останнього огляду — щоб черга тижневого огляду знала,
                 // про що вже питали.
                 (!('reviewedAt' in d) || d.reviewedAt == null ||
                   (d.reviewedAt is string && d.reviewedAt.size() == 10)) &&
                 // Горизонт планування: місяць чи рік. Старі документи поля не
                 // мають — вони заводились як довгострокові, тож без нього
                 // ціль вважається річною.
                 (!('horizon' in d) || d.horizon in ['month', 'year']) &&
                 // Місячна ціль може служити річній: рік — напрямок, місяці —
                 // кроки до нього. Без цього поля дві вкладки лишались просто
                 // двома списками, які нічого одне про одного не знають.
                 (!('parentGoalId' in d) || d.parentGoalId == null ||
                   (d.parentGoalId is string && d.parentGoalId.size() <= 64)) &&
                 // День, коли ціль закрили. Ретроспектива без нього вміє хіба
                 // вгадувати тривалість за останнім слідом у даних.
                 (!('completedAt' in d) || d.completedAt == null ||
                   (d.completedAt is string && d.completedAt.size() == 10)) &&
                 d.createdAt is timestamp && d.updatedAt is timestamp &&
                 d.keys().hasOnly(['title', 'category', 'why', 'targetDate', 'status',
                   'targetValue', 'currentValue', 'unit', 'rescues', 'blockers',
                   'progressLog', 'savingsGoalId', 'reviewedAt', 'horizon', 'parentGoalId', 'completedAt',
                   'milestones', 'checkins', 'journal', 'createdAt', 'updatedAt']);
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidLifeGoal(request.resource.data);
      }
    }

    // Все інше — заборонено за замовчуванням.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
